{
  "package": "dev.rea.setgo",
  "name": "SetGo",
  "versionName": "0.1.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "minAPILevel": 1,
  "icon": "/common/icon.png",
  "deviceTypeList": ["watch"],
  "features": [
    { "name": "system.router" },
    { "name": "system.storage" },
    { "name": "system.vibrator" },
    { "name": "system.brightness" }
  ],
  "config": { "logLevel": "warn", "designWidth": 192 },
  "display": { "backgroundColor": "#000000" },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": { "component": "index" },
      "pages/salvos": { "component": "salvos" },
      "pages/builder": { "component": "builder" },
      "pages/treino": { "component": "treino" },
      "pages/exercicio": { "component": "exercicio" }
    }
  }
}
