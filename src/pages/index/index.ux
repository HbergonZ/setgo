<template>
  <div class="page">

    <!-- MENU -->
    <div class="view menu" if="{{ vista === 'menu' }}">
      <text class="logo">SetGO</text>
      <text class="hint" if="{{ carregandoSessao }}">Carregando treino...</text>
      <text class="mbtn" onclick="irBuilder">Treino avulso</text>
      <text class="mbtn" onclick="irSalvos">Treinos salvos</text>
      <text class="cont" if="{{ temSessao }}" onclick="continuar">CONTINUAR TREINO</text>
    </div>

    <!-- SALVOS -->
    <div class="view" if="{{ vista === 'salvos' }}">
      <text class="titulo">TREINOS SALVOS</text>
      <div class="lista">
        <div class="row" for="{{ salvosView }}" onclick="abrirSalvo($idx)">
          <text class="saved-name">{{ $item.nome }}</text>
          <text class="saved-count">{{ $item.qtd }} exerc</text>
        </div>
      </div>
    </div>

    <!-- BUILDER -->
    <div class="view" if="{{ vista === 'builder' }}">
      <text class="titulo">MONTAR TREINO</text>
      <div class="builder-empty" if="{{ draft.length === 0 }}">
        <text class="vazio">Nenhum exercicio. Toque em Adicionar.</text>
      </div>
      <list class="lista builder-list" if="{{ draft.length > 0 }}">
        <list-item type="d" for="{{ draft }}" class="row">
          <text class="rnome">{{ $item.nome }}</text>
          <text class="rmeta">{{ $item.rotulo }}</text>
        </list-item>
      </list>
      <text class="add" onclick="abrirPickerBuilder">+ Adicionar</text>
      <text class="prim {{ draft.length ? '' : 'off' }}" onclick="iniciarAvulso">INICIAR</text>
    </div>

    <!-- PICKER -->
    <div class="view center" if="{{ vista === 'picker' }}">
      <text class="pt">{{ pickTitulo }}</text>
      <div class="chips">
        <text class="chip {{ tipo === 'reps' ? 'on' : '' }}" onclick="setTipo('reps')">Reps</text>
        <text class="chip {{ tipo === 'tempo' ? 'on' : '' }}" onclick="setTipo('tempo')">Tempo</text>
        <text class="chip {{ tipo === 'combo' ? 'on' : '' }}" onclick="setTipo('combo')">Combo</text>
      </div>
      <div class="stp" for="{{ linhas }}">
        <text class="sl">{{ $item.rotulo }}</text>
        <text class="sbtn" onclick="passo($item.chave, -1)">-</text>
        <text class="sval">{{ $item.valor }}</text>
        <text class="sbtn" onclick="passo($item.chave, 1)">+</text>
      </div>
      <div class="prow">
        <text class="pb sec" onclick="cancelarPicker">Cancelar</text>
        <text class="pb pri" onclick="addPicker">Adicionar</text>
      </div>
    </div>

    <!-- TREINO -->
    <div class="view" if="{{ vista === 'treino' }}">
      <text class="titulo">{{ ativoNome }}</text>
      <list class="lista {{ ativoAvulso ? 'treino-list-avulso' : 'treino-list' }}">
        <list-item type="e" for="{{ treinoView }}" class="row {{ $item.feito ? 'feito' : '' }}" onclick="abrirExercicio($idx)">
          <text class="rnome">{{ $item.nome }}</text>
          <text class="{{ $item.progClasse }} {{ $item.feito ? 'prog-feito' : '' }}">{{ $item.prog }}</text>
        </list-item>
      </list>
      <text class="add" if="{{ ativoAvulso }}" onclick="abrirPickerTreino">+ Adicionar</text>
      <text class="finish" if="{{ treinoCompleto }}" ontouchstart="holdStart" ontouchend="holdEnd" ontouchcancel="holdEnd">FINALIZAR</text>
      <div class="holdbar" if="{{ treinoCompleto }}"><div class="holdfill" style="width: {{ holdW }}px"></div></div>
      <text class="hint" if="{{ treinoCompleto }}">segure para finalizar</text>
      <text class="pausar" if="{{ !treinoCompleto }}" onclick="pausarESair">PAUSAR / SAIR</text>
    </div>

    <!-- EXERCICIO -->
    <div class="view" if="{{ vista === 'exercicio' }}">
      <text class="sit">{{ exSit }}</text>
      <text class="exnome">{{ exNome }}</text>
      <div class="bigrow">
        <text class="big">{{ exBig }}</text>
        <text class="bigden">{{ exDen }}</text>
      </div>
      <div class="meta-row">
        <text class="alvo {{ ativoAvulso ? 'alvo-full' : '' }}">{{ exAlvo }}</text>
        <text class="carga-link" if="{{ !ativoAvulso }}" onclick="abrirCarga">{{ exCarga }}</text>
      </div>
      <div class="dots">
        <text class="dot {{ $item ? 'f' : '' }}" for="{{ exDots }}"></text>
      </div>
      <text class="check {{ exFim ? 'next' : '' }}" onclick="checar">{{ exBotao }}</text>
      <text class="undo" onclick="desfazer">DESFAZER</text>
    </div>

    <!-- CARGA DO EXERCICIO SALVO -->
    <div class="view center" if="{{ vista === 'carga' }}">
      <text class="pt">CARGA</text>
      <text class="carga-nome">{{ exNome }}</text>
      <div class="carga-unidades">
        <text class="carga-unidade {{ cargaUnidade === 'kg' ? 'carga-unidade-on' : '' }}" onclick="selecionarKg">KG</text>
        <text class="carga-unidade {{ cargaUnidade === 'placas' ? 'carga-unidade-on' : '' }}" onclick="selecionarPlacas">PLACAS</text>
      </div>
      <text class="carga-valor">{{ cargaRotulo }}</text>
      <div class="carga-row">
        <text class="carga-btn" onclick="cargaMenos5">-5</text>
        <text class="carga-btn" onclick="cargaMenosMenor">{{ cargaMenosRotulo }}</text>
        <text class="carga-btn" onclick="cargaMaisMenor">{{ cargaMaisRotulo }}</text>
        <text class="carga-btn" onclick="cargaMais5">+5</text>
      </div>
      <div class="prow carga-actions">
        <text class="pb sec" onclick="cancelarCarga">Cancelar</text>
        <text class="pb pri" onclick="salvarCarga">Salvar</text>
      </div>
    </div>

    <!-- DESCANSO -->
    <div class="view center" if="{{ vista === 'descanso' }}">
      <text class="olab">Descanso</text>
      <text class="onum">{{ restNum }}</text>
      <div class="bar wide"><div class="barfill" style="width: {{ restW }}px"></div></div>
      <div class="prow">
        <text class="pb sec" onclick="mais15">+15s</text>
        <text class="pb pri" onclick="pularRest">Pular</text>
      </div>
    </div>

    <!-- TEMPO (isometria) -->
    <div class="view center" if="{{ vista === 'tempo' }}">
      <text class="olab roxo">Segure a posicao</text>
      <text class="onum">{{ tempoNum }}</text>
      <div class="bar wide roxobar"><div class="barfill" style="width: {{ tempoW }}px"></div></div>
      <div class="prow">
        <text class="pb sec" onclick="cancelarTempo">Cancelar</text>
        <text class="pb pri" onclick="prontoTempo">Pronto</text>
      </div>
    </div>

    <!-- TEMPO CONCLUIDO: aguarda confirmacao antes do descanso -->
    <div class="view center" if="{{ vista === 'tempoFim' }}">
      <text class="olab roxo">TEMPO CONCLUIDO</text>
      <text class="carga-nome">{{ exNome }}</text>
      <text class="csub">Toque em OK para continuar</text>
      <text class="prim ok" onclick="confirmarTempo">OK</text>
    </div>

    <!-- CONCLUIDO -->
    <div class="view center" if="{{ vista === 'concluido' }}">
      <text class="cbig">TREINO</text>
      <text class="cbig verde">CONCLUIDO</text>
      <text class="csub">{{ conclSub }}</text>
      <text class="prim ok" onclick="voltarMenu">OK</text>
    </div>

  </div>
</template>

<script>
import storage from '@system.storage'
import app from '@system.app'
import vibrator from '@system.vibrator'
import brightness from '@system.brightness'
import { SALVOS, novaSessao, alvoEx, metaEx, nomeCompativel, atualizarSessaoSalva, treinoFeito } from '../../common/modelo'
import { LINHAS, valoresPadrao, ajustar, montarEx } from '../../common/picker'
import { chaveCarga, ajustarCarga, rotuloCarga, lerCarga, criarCarga } from '../../common/cargas'

var CHAVE = 'setgo_sessao'
var CHAVE_CARGAS = 'setgo_cargas'
var LARGURA_HOLD = 154
var LARGURA_BAR = 150
var HOLD_MS = 1500
var holdTimer = null
var restTimer = null
var tempoTimer = null

function vibrar(modo) {
  try { vibrator.vibrate({ mode: modo }) } catch (e) {}
}

export default {
  private: {
    vista: 'menu',
    temSessao: false,
    carregandoSessao: true,
    cargas: {},
    salvosView: [],
    telaVisivel: false,
    draft: [],
    // picker
    tipo: 'reps',
    vals: { series: 3, reps: 12, seg: 30, a: 20, b: 10 },
    linhas: [],
    pickTitulo: 'Exercicio 1',
    pickFrom: 'builder',
    // treino ativo
    ativo: null,
    ativoNome: '',
    ativoAvulso: false,
    treinoView: [],
    treinoCompleto: false,
    curEx: 0,
    // exercicio
    exSit: '', exNome: '', exBig: '', exDen: '', exAlvo: '', exCarga: 'CARGA', exDots: [], exBotao: 'CHECK', exFim: false,
    cargaTemp: 0,
    cargaUnidade: 'kg',
    cargaMenosRotulo: '-0.5',
    cargaMaisRotulo: '+0.5',
    cargaRotulo: 'Sem carga',
    // timers
    holdW: 0,
    restNum: 0, restW: 0, restTotal: 30,
    tempoNum: 0, tempoW: 0,
    conclSub: ''
  },

  onInit() {
    this.salvosView = SALVOS.map(function (w) { return { nome: w.nome, qtd: w.ex.length } })
    var pagina = this
    var pendentes = 2
    function pronto() {
      pendentes--
      if (pendentes === 0) pagina.carregandoSessao = false
    }
    try {
      storage.get({
        key: CHAVE,
        success: function (txt) {
          var s = null
          try { s = txt ? JSON.parse(txt) : null } catch (e) { s = null }
          if (s && Array.isArray(s.ex) && s.ex.length > 0 && Array.isArray(s.done) && s.done.length === s.ex.length) {
            pagina.ativo = atualizarSessaoSalva(s)
            pagina.temSessao = true
            pagina.setAtivo(pagina.ativo)
            pagina.ativo.retomada = s.retomada || null
            pagina.salvar()
          }
          pronto()
        },
        fail: pronto
      })
    } catch (e) { pronto() }
    try {
      storage.get({
        key: CHAVE_CARGAS,
        success: function (txt) {
          var dados = {}
          try { dados = txt ? JSON.parse(txt) : {} } catch (e) { dados = {} }
          pagina.cargas = dados && typeof dados === 'object' ? dados : {}
          if (pagina.ativo) {
            pagina.montarTreinoView()
            if (pagina.vista === 'exercicio') pagina.renderEx()
          }
          pronto()
        },
        fail: pronto
      })
    } catch (e) { pronto() }
  },
  onShow() {
    this.telaVisivel = true
    if (this.vista === 'descanso') this.iniciarDescanso(this.restNum, this.restTotal)
    else if (this.vista === 'tempo') this.iniciarTempo(this.tempoNum)
    this.atualizarTela()
  },
  onHide() { this.telaVisivel = false; this.atualizarTela(); this.salvar(); this.pararTimers(); this.holdEnd() },
  onDestroy() { this.telaVisivel = false; this.atualizarTela(); this.salvar(); this.pararTimers(); this.pararHold() },

  mudarVista(vista) {
    if (vista === 'menu' || vista === 'salvos' || vista === 'builder') this.salvar()
    this.vista = vista
    this.atualizarTela()
    this.salvar()
  },
  atualizarTela() {
    var emTreino = ['treino', 'exercicio', 'carga', 'descanso', 'tempo', 'tempoFim'].indexOf(this.vista) >= 0 || (this.vista === 'picker' && this.pickFrom === 'treino')
    try { brightness.setKeepScreenOn({ keepScreenOn: this.telaVisivel && emTreino }) } catch (e) {}
  },

  // Botao voltar: navega dentro do app; no menu, deixa sair.
  onBackPress() {
    var v = this.vista
    if (v === 'menu') return false
    if (v === 'exercicio') { this.mudarVista('treino'); this.montarTreinoView() }
    else if (v === 'carga') { this.mudarVista('exercicio') }
    else if (v === 'picker') { this.mudarVista(this.pickFrom) }
    else if (v === 'descanso') { this.pularRest() }
    else if (v === 'tempo') { this.cancelarTempo() }
    else if (v === 'tempoFim') { this.mudarVista('menu') }
    else if (v === 'concluido') { this.voltarMenu() }
    else if (v === 'treino' && this.ativo && this.ativo.modo === 'salvo') { this.mudarVista('salvos') }
    else { this.mudarVista('menu') }
    return true
  },

  pausarESair() {
    this.onHide()
    if (!this.ativo) { app.terminate(); return }
    try {
      storage.set({ key: CHAVE, value: JSON.stringify(this.ativo), success: function () { app.terminate() } })
    } catch (e) {}
  },

  salvar() {
    if (!this.ativo || this.vista === 'concluido') return
    if (['treino', 'exercicio', 'carga', 'descanso', 'tempo', 'tempoFim'].indexOf(this.vista) >= 0) {
      this.ativo.retomada = { vista: this.vista === 'carga' ? 'exercicio' : this.vista, curEx: this.curEx, restNum: this.restNum, restTotal: this.restTotal, tempoNum: this.tempoNum }
    }
    try { storage.set({ key: CHAVE, value: JSON.stringify(this.ativo) }) } catch (e) {}
  },
  apagar() { try { storage.delete({ key: CHAVE }) } catch (e) {} },
  persistirCargas() { try { storage.set({ key: CHAVE_CARGAS, value: JSON.stringify(this.cargas) }) } catch (e) {} },

  // ---- Navegacao ----
  irBuilder() { if (this.carregandoSessao) return; this.draft = []; this.mudarVista('builder') },
  irSalvos() { if (!this.carregandoSessao) this.mudarVista('salvos') },
  continuar() {
    if (!this.ativo || this.carregandoSessao) return
    var r = this.ativo.retomada
    this.setAtivo(this.ativo)
    if (!r || r.curEx < 0 || r.curEx >= this.ativo.ex.length) { this.mudarVista('treino'); return }
    this.curEx = r.curEx
    this.renderEx()
    if (r.vista === 'descanso' && r.restNum > 0) this.iniciarDescanso(r.restNum, r.restTotal)
    else if (r.vista === 'tempo' && r.tempoNum > 0) this.iniciarTempo(r.tempoNum)
    else if (r.vista === 'tempoFim') this.mudarVista('tempoFim')
    else this.mudarVista(r.vista === 'exercicio' ? 'exercicio' : 'treino')
  },

  abrirSalvo(i) {
    if (this.carregandoSessao) return
    if (this.ativo && this.ativo.modo === 'salvo' && nomeCompativel(this.ativo.nome) === SALVOS[i].nome) {
      var retomada = this.ativo.retomada
      this.ativo = atualizarSessaoSalva(this.ativo)
      this.ativo.retomada = retomada
      this.setAtivo(this.ativo)
      this.salvar()
      this.mudarVista('treino')
      return
    }
    this.ativo = novaSessao(SALVOS[i], 'salvo')
    this.salvar(); this.temSessao = true
    this.setAtivo(this.ativo)
    this.mudarVista('treino')
  },
  iniciarAvulso() {
    if (this.carregandoSessao) return
    if (this.draft.length === 0) return
    var limpos = this.draft.map(function (e) {
      var c = {}
      for (var k in e) if (k !== 'rotulo') c[k] = e[k]
      return c
    })
    this.ativo = novaSessao({ nome: 'Treino avulso', ex: limpos }, 'avulso')
    this.salvar(); this.temSessao = true
    this.setAtivo(this.ativo)
    this.mudarVista('treino')
  },
  setAtivo(s) {
    this.ativoNome = nomeCompativel(s.nome)
    this.ativoAvulso = s.modo === 'avulso'
    this.montarTreinoView()
  },
  montarTreinoView() {
    var s = this.ativo
    this.treinoCompleto = treinoFeito(s)
    var pagina = this
    this.treinoView = s.ex.map(function (e, i) {
      var prog = s.done[i] + '/' + e.series
      var temCarga = false
      if (s.modo === 'salvo') {
        var carga = pagina.cargas[chaveCarga(nomeCompativel(s.nome), nomeCompativel(e.nome))]
        if (lerCarga(carga).valor > 0) { prog += '\n' + rotuloCarga(carga); temCarga = true }
      }
      return { nome: nomeCompativel(e.nome), prog: prog, progClasse: temCarga ? 'rprog-carga' : 'rprog', feito: s.done[i] >= e.series }
    })
  },

  // ---- Picker ----
  montarLinhas() {
    var vals = this.vals
    this.linhas = LINHAS[this.tipo].map(function (par) {
      return { chave: par[0], rotulo: par[1], valor: vals[par[0]] }
    })
  },
  abrirPicker(origem, qtd) {
    this.pickFrom = origem
    this.tipo = 'reps'
    this.vals = valoresPadrao()
    this.pickTitulo = 'Exercicio ' + (qtd + 1)
    this.montarLinhas()
    this.mudarVista('picker')
  },
  abrirPickerBuilder() { this.abrirPicker('builder', this.draft.length) },
  abrirPickerTreino() { this.abrirPicker('treino', this.ativo.ex.length) },
  setTipo(t) { this.tipo = t; this.montarLinhas() },
  passo(chave, delta) { this.vals[chave] = ajustar(this.vals[chave], chave, delta); this.montarLinhas() },
  cancelarPicker() { this.mudarVista(this.pickFrom) },
  addPicker() {
    if (this.pickFrom === 'builder') {
      var ex = montarEx('Exercicio ' + (this.draft.length + 1), this.tipo, this.vals)
      ex.rotulo = metaEx(ex)
      this.draft = this.draft.concat([ex])
      this.mudarVista('builder')
    } else {
      var ex2 = montarEx('Exercicio ' + (this.ativo.ex.length + 1), this.tipo, this.vals)
      this.ativo.ex.push(ex2)
      this.ativo.done.push(0)
      this.salvar()
      this.montarTreinoView()
      this.mudarVista('treino')
    }
  },

  // ---- Exercicio ----
  abrirExercicio(i) { this.curEx = i; this.renderEx(); this.mudarVista('exercicio') },
  renderEx() {
    var e = this.ativo.ex[this.curEx]
    var d = this.ativo.done[this.curEx]
    this.exNome = nomeCompativel(e.nome)
    this.exAlvo = alvoEx(e)
    if (!this.ativoAvulso) {
      var chave = chaveCarga(this.ativoNome, this.exNome)
      this.exCarga = lerCarga(this.cargas[chave]).valor > 0 ? rotuloCarga(this.cargas[chave]) : 'CARGA'
    }
    this.exFim = d >= e.series
    if (this.exFim) {
      this.exSit = 'EXERCICIO FEITO'
      this.exBig = 'OK'; this.exDen = ''
      this.exBotao = 'VOLTAR'
    } else {
      this.exSit = 'SERIE ' + (d + 1) + ' de ' + e.series
      this.exBig = String(d + 1); this.exDen = '/' + e.series
      this.exBotao = 'CHECK'
    }
    var dots = []
    for (var k = 0; k < e.series; k++) dots.push(k < d)
    this.exDots = dots
  },
  checar() {
    var e = this.ativo.ex[this.curEx]
    if (this.ativo.done[this.curEx] >= e.series) {
      this.montarTreinoView(); this.mudarVista('treino')
      return
    }
    if (e.tipo === 'tempo') this.iniciarTempo(e.seg)
    else this.concluirSerie()
  },
  concluirSerie(silencioso) {
    var e = this.ativo.ex[this.curEx]
    this.mudarVista('exercicio')
    this.ativo.done[this.curEx]++
    this.salvar()
    this.renderEx()
    this.montarTreinoView()
    if (this.ativo.done[this.curEx] < e.series) { if (!silencioso) vibrar('short'); this.iniciarDescanso(e.descanso) }
    else { if (!silencioso) vibrar('long'); this.mudarVista('treino') }
  },
  desfazer() {
    if (this.ativo.done[this.curEx] > 0) { this.ativo.done[this.curEx]--; this.salvar(); this.renderEx(); this.montarTreinoView() }
  },

  // ---- Carga persistente dos treinos salvos ----
  abrirCarga() {
    if (this.ativoAvulso) return
    var chave = chaveCarga(this.ativoNome, this.exNome)
    var carga = lerCarga(this.cargas[chave])
    this.cargaTemp = carga.valor
    this.aplicarUnidadeCarga(carga.unidade)
    this.atualizarRotuloCarga()
    this.mudarVista('carga')
  },
  aplicarUnidadeCarga(unidade) {
    this.cargaUnidade = unidade === 'placas' ? 'placas' : 'kg'
    this.cargaMenosRotulo = this.cargaUnidade === 'placas' ? '-1' : '-0.5'
    this.cargaMaisRotulo = this.cargaUnidade === 'placas' ? '+1' : '+0.5'
  },
  atualizarRotuloCarga() { this.cargaRotulo = rotuloCarga({ valor: this.cargaTemp, unidade: this.cargaUnidade }) },
  selecionarKg() { if (this.cargaUnidade !== 'kg') { this.cargaTemp = 0; this.aplicarUnidadeCarga('kg'); this.atualizarRotuloCarga() } },
  selecionarPlacas() { if (this.cargaUnidade !== 'placas') { this.cargaTemp = 0; this.aplicarUnidadeCarga('placas'); this.atualizarRotuloCarga() } },
  ajustarCargaTela(delta) {
    this.cargaTemp = ajustarCarga(this.cargaTemp, delta)
    if (this.cargaUnidade === 'placas') this.cargaTemp = Math.round(this.cargaTemp)
    this.atualizarRotuloCarga()
  },
  cargaMenos5() { this.ajustarCargaTela(-5) },
  cargaMenosMenor() { this.ajustarCargaTela(this.cargaUnidade === 'placas' ? -1 : -0.5) },
  cargaMaisMenor() { this.ajustarCargaTela(this.cargaUnidade === 'placas' ? 1 : 0.5) },
  cargaMais5() { this.ajustarCargaTela(5) },
  cancelarCarga() { this.mudarVista('exercicio') },
  salvarCarga() {
    var chave = chaveCarga(this.ativoNome, this.exNome)
    var copia = {}
    for (var k in this.cargas) copia[k] = this.cargas[k]
    if (this.cargaTemp > 0) copia[chave] = criarCarga(this.cargaTemp, this.cargaUnidade)
    else delete copia[chave]
    this.cargas = copia
    this.persistirCargas()
    this.renderEx()
    this.montarTreinoView()
    this.mudarVista('exercicio')
  },

  // ---- Isometria ----
  iniciarTempo(seg) {
    var pagina = this
    this.pararTimers()
    this.tempoNum = seg
    this.tempoW = LARGURA_BAR
    this.mudarVista('tempo')
    var total = seg
    var inicio = Date.now()
    tempoTimer = setInterval(function () {
      var resta = total - (Date.now() - inicio) / 1000
      if (resta <= 0) pagina.terminarTempo()
      else { pagina.tempoNum = Math.ceil(resta); pagina.tempoW = Math.round(resta / total * LARGURA_BAR) }
    }, 100)
  },
  terminarTempo() {
    if (this.vista !== 'tempo') return
    this.pararTimers()
    this.tempoNum = 0
    this.tempoW = 0
    this.renderEx()
    this.mudarVista('tempoFim')
    vibrar('long')
  },
  prontoTempo() { this.terminarTempo() },
  confirmarTempo() {
    if (this.vista !== 'tempoFim') return
    this.concluirSerie(true)
  },
  cancelarTempo() { this.pararTimers(); this.mudarVista('exercicio') },

  // ---- Descanso ----
  iniciarDescanso(seg, total) {
    var pagina = this
    this.pararTimers()
    this.restTotal = total || seg
    this.restNum = seg
    this.restW = Math.round(seg / this.restTotal * LARGURA_BAR)
    this.mudarVista('descanso')
    restTimer = setInterval(function () {
      pagina.restNum--
      pagina.restW = Math.round(pagina.restNum / pagina.restTotal * LARGURA_BAR)
      if (pagina.restNum <= 0) { pagina.pararTimers(); vibrar('long'); pagina.mudarVista('exercicio') }
    }, 1000)
  },
  mais15() { this.restNum += 15; this.restTotal += 15; this.restW = Math.round(this.restNum / this.restTotal * LARGURA_BAR) },
  pularRest() { this.pararTimers(); this.mudarVista('exercicio') },

  pararTimers() {
    if (restTimer !== null) { clearInterval(restTimer); restTimer = null }
    if (tempoTimer !== null) { clearInterval(tempoTimer); tempoTimer = null }
  },

  // ---- Finalizar (segurar) ----
  holdStart() {
    if (!treinoFeito(this.ativo)) return
    var pagina = this
    this.pararHold()
    var inicio = Date.now()
    holdTimer = setInterval(function () {
      var p = (Date.now() - inicio) / HOLD_MS
      if (p >= 1) { pagina.holdW = LARGURA_HOLD; pagina.pararHold(); pagina.finalizar() }
      else pagina.holdW = Math.round(p * LARGURA_HOLD)
    }, 50)
  },
  holdEnd() { this.pararHold(); this.holdW = 0 },
  pararHold() { if (holdTimer !== null) { clearInterval(holdTimer); holdTimer = null } },
  finalizar() {
    if (!treinoFeito(this.ativo)) return
    this.apagar()
    this.conclSub = this.ativoAvulso ? 'Treino avulso descartado.' : this.ativoNome + ' concluido.'
    this.mudarVista('concluido')
  },
  voltarMenu() {
    this.apagar()
    this.ativo = null
    this.temSessao = false
    this.holdW = 0
    this.mudarVista('menu')
  }
}
</script>

